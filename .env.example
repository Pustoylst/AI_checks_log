# Необязательно: значения по умолчанию уже включают локальную модель.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192

# Необязательная GitHub-интеграция требует интернета.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_API_URL=https://api.github.com
GITHUB_DEFAULT_BRANCH=main
CI_POLL_INTERVAL_SECONDS=60
CI_STATE_DIR=../agent-ci-runtime
