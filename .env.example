# Необязательно: значения по умолчанию уже включают локальную модель.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
# Гибридный поиск: BM25 + локальная BGE-M3. Индекс: python -m tools.index_documentation
RAG_VECTOR_ENABLED=true
RAG_EMBEDDING_MODEL=bge-m3:latest
RAG_EMBEDDING_BATCH_SIZE=16
RAG_VECTOR_MIN_SIMILARITY=0.45
# Папка с HTML-документацией Directum RX 26.2 (по умолчанию соседняя ../rx262).
# DIRECTUM_DOCS_PATH=..\rx262
# 8192 достаточно для выжимки одного лога (14 000 символов). Для общей сводки
# на 16 000 символов и запаса под ответ модели лучше 16384 при наличии RAM.
OLLAMA_NUM_CTX=8192

# Необязательная GitHub-интеграция требует интернета.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_API_URL=https://api.github.com
GITHUB_DEFAULT_BRANCH=main
CI_POLL_INTERVAL_SECONDS=60
CI_STATE_DIR=../agent-ci-runtime

# Сетевая папка с логами Directum (доступ под текущей учётной записью Windows).
LOG_SHARE_PATH=\\192.168.240.2\Logs
LOG_SHARE_MAX_FILES=200
LOG_SHARE_SCAN_LIMIT=5000

# Предобработка больших логов: бюджет отчёта и максимальный размер файла.
LOG_PREPROCESS_BUDGET_CHARS=14000
LOG_PREPROCESS_MAX_BYTES=536870912

# Общая сводка по многим логам: охват сканирования и бюджет итогового отчёта.
# 3 ГиБ покрывает текущие 2,61 ГиБ папки с запасом; 1000 файлов — больше, чем сейчас.
LOG_OVERVIEW_MAX_FILES=1000
LOG_OVERVIEW_MAX_BYTES=3221225472
LOG_OVERVIEW_BUDGET_CHARS=16000
